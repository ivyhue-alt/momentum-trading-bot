# Copy this file to ".env" (no extension prefix) and fill in real values.
# NEVER commit .env to GitHub - .gitignore already blocks it.

# Alpaca (paper trading)
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER=true

# Telegram alerts (see heartbeat.py for 3-min setup)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

